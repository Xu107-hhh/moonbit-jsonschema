name = "Xu107-hhh/moonbit-jsonschema"

version = "0.1.0"

readme = "README.mbt.md"

repository = "https://github.com/Xu107-hhh/moonbit-jsonschema"

license = "Apache-2.0"

keywords = [ "json-schema", "validation", "json", "llm" ]

preferred_target = "wasm"

description = "A standards-compliant JSON Schema (2020-12) validator for MoonBit, with precise error paths and full error collection."
